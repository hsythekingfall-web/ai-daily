<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>归档 · AI 前沿日报</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="page">
  <header class="site-head">
    <div class="brand">AI 前沿日报</div>
    <nav>
      <a href="index.html">今日</a>
      <a href="archive.html" class="active">归档</a>
    </nav>
  </header>

  <h1 class="date-title">往期归档</h1>
  {% if dates %}
  <ul class="archive-list">
    {% for row in dates %}
    <li>
      <a href="days/{{ row.first_seen_date }}.html">{{ fmt_date(row.first_seen_date) }}</a>
      <span class="count">{{ row.n }} 条</span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <div class="empty">还没有数据,先运行一次采集:<code>python run.py</code></div>
  {% endif %}

  <footer>由 ai-daily 采集器自动生成</footer>
</div>
</body>
</html>
