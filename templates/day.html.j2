{% macro cluster_card(c, rank=None) %}
<article class="card{% if rank %} top-card{% endif %}">
  {% if rank %}<div class="rank">{{ rank }}</div>{% endif %}
  <div class="card-body">
    <a class="title" href="{{ c.lead.url }}" target="_blank" rel="noopener" title="{{ c.lead.title }}">{{ c.lead.title_zh or c.lead.title }}</a>
    <div class="meta">
      <span class="source">{{ c.lead.source_name }}</span>
      {% if c.lead.published_at %}<span class="sep">·</span><time>{{ c.lead.published_at | fmt_time }}</time>{% endif %}
      <span class="chip">{{ c.lead.category }}</span>
      <span class="dots" title="重要度">{{ c.lead.importance | dots }}</span>
    </div>
    {% set body = c.lead.summary_zh or c.lead.summary %}
    {% if body %}<p class="summary">{{ body }}</p>{% endif %}
    {% if c.related %}
    <div class="related">相关报道:
      {% for r in c.related %}<a href="{{ r.url }}" target="_blank" rel="noopener" title="{{ r.title }}">{{ r.source_name }}</a>{% if not loop.last %}、{% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
</article>
{% endmacro %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if date_str %}AI 前沿日报 · {{ fmt_date_str }}{% else %}AI 前沿日报{% endif %}</title>
<link rel="stylesheet" href="{{ root }}/style.css">
</head>
<body>
<div class="page">
  <header class="site-head">
    <div class="brand">AI 前沿日报</div>
    <nav>
      <a href="{{ root }}/index.html" {% if latest %}class="active"{% endif %}>今日</a>
      <a href="{{ root }}/archive.html">归档</a>
    </nav>
  </header>

  {% if not date_str %}
  <div class="empty">还没有数据,先运行一次采集:<code>python run.py</code></div>
  {% else %}
  <h1 class="date-title">{{ fmt_date_str }}<span class="count">共 {{ total }} 条</span></h1>

  {% if top %}
  <section>
    <h2>今日必读</h2>
    {% for c in top %}
    {{ cluster_card(c, rank=loop.index) }}
    {% endfor %}
  </section>
  {% endif %}

  {% for category, clusters in groups %}
  <section>
    <h2><span class="chip">{{ category }}</span></h2>
    {% for c in clusters %}
    {{ cluster_card(c) }}
    {% endfor %}
  </section>
  {% endfor %}
  {% endif %}

  <footer>由 ai-daily 采集器于 {{ generated_at }} 自动生成 · 内容来自公开 RSS,仅收录标题、摘要与原文链接</footer>
</div>
</body>
</html>
